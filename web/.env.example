# Copy to web/.env (git-ignored). Everything here ships to the browser: never put keys here.
# testnet (default) or mainnet
VITE_NETWORK=testnet
# Optional primary RPC. Falls back to the public Monad RPC. Anything here is public in the bundle.
VITE_RPC_URL_TESTNET=
VITE_RPC_URL_MAINNET=
# Optional: enables the WalletConnect option in the connect modal (Reown project id; public in the bundle)
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: set to `none` to skip the faster third-party log RPC used for event history (the public RPC is always the fallback).
VITE_LOGS_RPC=
