# Copy to .env (git-ignored). ONE file for the scripts and the agent. Testnet only, throwaway keys.
# Never put a mainnet key here.

# Optional: primary RPC (e.g. Alchemy Monad). Falls back to the public RPC.
RPC_URL=

# scripts/*.ts: owner wallet (needs testnet MON for gas + testnet USDC >= 30)
OWNER_PRIVATE_KEY=
# Agent wallet address (must match AGENT_PRIVATE_KEY)
AGENT_ADDRESS=

# agent: the agent wallet's key (holds only MON for gas) and the rein it pays from
AGENT_PRIVATE_KEY=
REIN_ID=
# Recipient the injected page tells the agent to pay (any address you don't care about)
ATTACKER_ADDRESS=
